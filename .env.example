# ─── Supabase ──────────────────────────────────────────────
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clau publicable (sb_publishable_...). Pot anar al navegador: la seguretat la donen les RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# No cal clau secreta: el registre per invitació es valida dins Postgres.

# ─── App ───────────────────────────────────────────────────
# URL pública (s'usa per construir enllaços d'invitació i de recuperació)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
